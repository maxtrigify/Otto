#!/usr/bin/env python3
"""Stamp the operator-owned HTTPS endpoint into an app before code signing.

Omitting OTTO_PRIVATE_PHONE_URL (or the pre-rename MUSE_PRIVATE_PHONE_URL) preserves the packaged default. End users never
configure this value. No credential is accepted by this script.
"""
import os
import plistlib
import sys
from pathlib import Path
from urllib.parse import urlsplit

value = os.environ.get('OTTO_PRIVATE_PHONE_URL') or os.environ.get('MUSE_PRIVATE_PHONE_URL')
if value:
    url = urlsplit(value)
    if (url.scheme != 'https' or not url.hostname or url.username or url.password
            or url.query or url.fragment or url.path not in ('', '/')):
        sys.exit('OTTO_PRIVATE_PHONE_URL must be a plain HTTPS origin')
    path = Path(sys.argv[1])
    with path.open('rb') as source:
        info = plistlib.load(source)
    info['OttoPrivatePhoneURL'] = value.rstrip('/')
    with path.open('wb') as output:
        plistlib.dump(info, output, sort_keys=False)
