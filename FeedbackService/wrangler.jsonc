{
  // No account_id here: this folder is public. Wrangler picks the account from `wrangler login`
  // (or CLOUDFLARE_ACCOUNT_ID in the deploying shell).
  "name": "otto-feedback",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [{"pattern": "feedback.openotto.io", "custom_domain": true}],
  "vars": {"GITHUB_REPO": "maxtrigify/Otto"},
  // The rate limiting binding only counts over 10 or 60 second windows.
  "ratelimits": [
    {"name": "INSTALL_LIMIT", "namespace_id": "2001", "simple": {"limit": 2, "period": 60}},
    {"name": "IP_LIMIT", "namespace_id": "2002", "simple": {"limit": 5, "period": 60}},
    {"name": "GLOBAL_LIMIT", "namespace_id": "2003", "simple": {"limit": 30, "period": 60}}
  ],
  "observability": {"enabled": false}
}
